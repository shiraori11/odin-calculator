body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 90vh;
  width: 100vw;
}

button {
  flex: 1;
}

.operator {
  flex: 1 1 auto;
  width: 40px;
}

.calculator-container,
.operator-container,
.num-container {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.operator-container {
  flex: 0 1 auto;
}

.calculator-container {
  width: 30%;
  max-height: 60%;
  background-color: grey;
  padding: 5px;
}

.row-one,
.row-two,
.row-three,
.row-four{
  display: flex;
  justify-content: space-evenly;
  flex: 2 1 auto;
}

.row-four {
  justify-content: stretch;
}

.input-container {
  display: flex;
  flex-direction: row;
  flex: 1;
}

.display {
  background-color: white;
  overflow: hidden;
}
